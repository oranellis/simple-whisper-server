[Unit]
Description=Faster Whisper streaming transcription server
After=network.target

[Service]
Type=simple
User=oran
WorkingDirectory=/home/oran/Services/whisper
EnvironmentFile=-/home/oran/Services/whisper/whisper-server.env
ExecStart=/home/oran/Services/whisper/run.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
